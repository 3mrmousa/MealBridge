// Users Enums

enum Role {
  DONOR
  RECIPIENT
  VOLUNTEER
  ADMIN
  MANAGER

  @@map("role")
}

enum VolunteerType {
  INDIVIDUAL
  ORGANIZATION

  @@map("volunteer_type")
}

enum TransportType {
  CAR
  PUBLIC_TRANSPORT
  VAN
  BICYCLE
  MOTORCYCLE
  WALKING
  OTHER

  @@map("transport_type")
}

enum DonorOrganizationType {
  RESTAURANT
  CAFE
  HOTEL
  CATERING
  GOVERNMENT
  OTHER

  @@map("donor_organization_type")
}

enum RecipientOrganizationType {
  SHELTER
  COMMUNITY_CENTER
  CHARITY
  GOVERNMENT
  OTHER

  @@map("recipient_organization_type")
}

// Donation Enums

enum DonationStatus {
  AVAILABLE
  COMPLETED
  CANCELLED
  EXPIRED

  @@map("donation_status")
}

enum DonationRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED

  @@map("donation_request_status")
}

enum ClaimStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("claim_status")
}

// Pickup Enums

enum PickupMethod {
  SELF
  VOLUNTEER

  @@map("pickup_method")
}

enum DeliveryRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED

  @@map("delivery_request_status")
}

enum DeliveryStatus {
  PENDING
  CANCELLED
  COMPLETED

  @@map("delivery_status")
}

enum CancelRequestStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("cancel_request_status")
}

// Last added

enum ConversationType {
  DONOR_RECIPIENT
  RECIPIENT_VOLUNTEER

  @@map("conversation_type")
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED

  @@map("report_status")
}
